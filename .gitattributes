# Enforce LF line endings on shell scripts — a CRLF shebang (`#!/bin/sh\r`)
# breaks container entrypoints ("no such file or directory") and POSIX scripts.
*.sh text eol=lf

# Keep the rest of the repo's text files on LF too (Biome formats to LF).
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf