{
    "name": "@deltabox/toolchain",
    "version": "3.0.0-beta.7",
    "description": "A superset of Vite+ with rich extras: project synchronization, config generator, tsconfig management, MCP server, CI and changelog automation, providers, catalogs and a VS Code extension. Use it as a Vite plugin or standalone.",
    "homepage": "https://toolchain.deltabox.studio",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git"
    },
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "bin": {
        "dbx": "./dist/cli/index.js"
    },
    "keywords": [
        "tooling",
        "cli",
        "monorepo",
        "tsconfig",
        "codegen",
        "tsdown",
        "biome",
        "oxlint",
        "vite",
        "viteplus",
        "vite-plus",
        "changelog",
        "scaffold",
        "docker",
        "container",
        "extension",
        "zod",
        "types",
        "markdown",
        "environment",
        "variables",
        "configuration",
        "settings",
        "dbx"
    ],
    "scripts": {
        "dev": "tsx src/cli/index.ts",
        "build": "vp run --filter \"./packages/*\" build && vp run -w build:root && yarn build:vscode && yarn dbx sync --only tsconfig",
        "build:vscode": "yarn workspace toolchain-vscode package:vsix",
        "docs": "vp run --filter \"./apps/docs\"",
        "format": "vp run --filter \"./packages/*\" format && vp run -w format:root",
        "format:check": "vp run --filter \"./packages/*\" format:check && vp run -w format:check:root",
        "lint": "vp run --filter \"./packages/*\" lint && vp run -w lint:root",
        "lint:check": "vp run --filter \"./packages/*\" lint:check && vp run -w lint:check:root",
        "check": "vp run --filter \"./packages/*\" check && vp run -w check:root",
        "check:fix": "vp run --filter \"./packages/*\" check:fix && vp run -w check:fix:root",
        "typecheck": "vp run --filter \"./packages/*\" typecheck && vp run -w typecheck:root",
        "test": "vp run --filter \"./packages/*\" build && vp run -w build:root && vp run --filter \"./packages/*\" test && vp run -w test:root",
        "test:repo": "tsx scripts/test-repo.ts",
        "test:clean": "node scripts/clean-emulate.mjs",
        "releases:reformat": "tsx scripts/reformat-github-releases.ts",
        "vp:test": "vp test --run --config vite.config.ts",
        "vp:toolchain": "vp toolchain",
        "config:generate": "tsx scripts/generate-tool-config-types.ts && tsx scripts/generate-workflow-types.ts && tsx scripts/generate-config-types.ts && tsx scripts/generate-config.ts && tsx scripts/generate-config-docs.ts",
        "config:docs": "tsx scripts/generate-config-docs.ts",
        "config:types": "tsx scripts/generate-config-types.ts",
        "dbx": "tsx src/cli/index.ts",
        "commitlint": "commitlint",
        "postinstall": "node scripts/bootstrap.mjs"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "dependencies": {
        "@clack/prompts": "catalog:",
        "commander": "^14.0.0",
        "glob": "catalog:",
        "jsonc-parser": "^3.3.1",
        "lodash": "catalog:",
        "picocolors": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "untyped": "^2.0.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@deltabox/toolchain": "portal:.",
        "@deltabox/toolchain-biome": "workspace:*",
        "@deltabox/toolchain-changelog": "workspace:*",
        "@deltabox/toolchain-config": "workspace:*",
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-docker": "workspace:*",
        "@deltabox/toolchain-mcp": "workspace:*",
        "@deltabox/toolchain-migrate": "workspace:*",
        "@deltabox/toolchain-pack": "workspace:*",
        "@deltabox/toolchain-project": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*",
        "@deltabox/toolchain-template": "workspace:*",
        "@deltabox/toolchain-tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@typescript/native-preview": "catalog:",
        "ajv": "^8.20.0",
        "cross-env": "catalog:",
        "dotenv": "catalog:",
        "husky": "^9.1.7",
        "publint": "^0.3.24",
        "typescript": "catalog:",
        "unrun": "^0.3.1",
        "vite-plugin-dbx": "workspace:*",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@dprint/types": ">=0.4",
        "eslint": ">=9",
        "prettier": ">=3",
        "vite-plus": ">=1"
    },
    "peerDependenciesMeta": {
        "@dprint/types": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "prettier": {
            "optional": true
        },
        "vite-plus": {
            "optional": true
        }
    },
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": ">=22.5.0"
    },
    "files": [
        "dist",
        "scripts/bootstrap.mjs"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./biome": "./dist/biome.js",
        "./changelog": "./dist/changelog.js",
        "./cli": "./dist/cli/index.js",
        "./config": "./dist/config.js",
        "./core": "./dist/core.js",
        "./docker": "./dist/docker.js",
        "./globals": "./dist/globals.js",
        "./mcp": "./dist/mcp.js",
        "./migrate": "./dist/migrate.js",
        "./pack": "./dist/pack.js",
        "./project": "./dist/project.js",
        "./providers": "./dist/providers.js",
        "./shared": "./dist/shared.js",
        "./template": "./dist/template.js",
        "./tsconfig": "./dist/tsconfig.js",
        "./vite": "./dist/vite.js",
        "./package.json": "./package.json"
    }
}
