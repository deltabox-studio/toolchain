{
    "name": "@deltabox/toolchain-changelog",
    "version": "2.6.1",
    "description": "Conventional-Commits changelog and versioning pipeline with commitlint, changelog formatting/rendering and CI workflow templates.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/changelog"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "generate:workflows": "tsx scripts/generate-workflows.ts"
    },
    "dependencies": {
        "@deltabox/toolchain-shared": "workspace:*"
    },
    "devDependencies": {
        "@deltabox/toolchain-pack": "workspace:*",
        "@types/node": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./bin": "./dist/bin.js",
        "./cli": "./dist/cli/index.js",
        "./run": "./dist/run.js",
        "./package.json": "./package.json"
    },
    "bin": "./dist/bin.js",
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1",
    "keywords": [
        "changelog",
        "conventional-commits",
        "commitlint",
        "versioning",
        "release",
        "ci",
        "dbx",
        "deltabox",
        "toolchain"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
