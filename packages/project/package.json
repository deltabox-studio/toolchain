{
    "name": "@deltabox/toolchain-project",
    "version": "3.0.0-beta.5",
    "private": true,
    "description": "Project and workspace scaffolding generators: TypeScript roots, monorepos, catalogs, package.json, tsconfig and Vite/dbx config files.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/project"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@clack/prompts": "catalog:",
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-docker": "workspace:*",
        "@deltabox/toolchain-migrate": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*",
        "@deltabox/toolchain-tsconfig": "workspace:*",
        "jsonc-parser": "catalog:"
    },
    "devDependencies": {
        "@deltabox/toolchain-pack": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./package.json": "./package.json"
    },
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1",
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
