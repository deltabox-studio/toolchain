{
    "name": "@deltabox/toolchain-template",
    "version": "2.6.1",
    "description": "Custom project, tooling and pipeline template registry with builtin, local and online (npm/git/Vite+) sources.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/template"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@clack/prompts": "catalog:",
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-docker": "workspace:*",
        "@deltabox/toolchain-project": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*",
        "vite-plugin-dbx": "workspace:*"
    },
    "devDependencies": {
        "@deltabox/toolchain-pack": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./package.json": "./package.json"
    },
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1",
    "keywords": [
        "template",
        "registry",
        "scaffold",
        "npm",
        "git",
        "dbx",
        "deltabox",
        "toolchain"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
