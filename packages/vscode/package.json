{
    "name": "toolchain-vscode",
    "displayName": "deltabox toolchain",
    "description": "All-in-one development toolchain that let's you scaffold projects, generate and manage configs, tsconfigs, custom templates, syncing, changelogs, CI, Vite+, migrations, and more.",
    "version": "2.1.1",
    "private": true,
    "type": "module",
    "publisher": "deltabox",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/vscode"
    },
    "icon": "resources/logo.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.cjs",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "deltabox.toolchain.sync",
                "title": "Sync active project",
                "category": "deltabox",
                "icon": "$(sync)",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.syncSelected",
                "title": "Sync selected projects",
                "category": "deltabox",
                "icon": "$(checklist)",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.syncAll",
                "title": "Sync all projects",
                "category": "deltabox",
                "icon": "$(sync)",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.syncCheck",
                "title": "Check sync",
                "category": "deltabox",
                "icon": "$(check-all)",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.chooseDbxSource",
                "title": "Choose dbx source (project vs extension)",
                "category": "deltabox",
                "icon": "$(symbol-enum)"
            },
            {
                "command": "deltabox.toolchain.selectVersion",
                "title": "Select dbx version…",
                "category": "deltabox",
                "icon": "$(versions)"
            },
            {
                "command": "deltabox.toolchain.syncProject",
                "title": "Sync this project",
                "category": "deltabox",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.checkProject",
                "title": "Check sync",
                "category": "deltabox",
                "icon": "$(check-all)",
                "enablement": "deltabox.canSync"
            },
            {
                "command": "deltabox.toolchain.scaffold",
                "title": "Scaffold project…",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.generateConfigs",
                "title": "Generate configs…",
                "category": "deltabox",
                "icon": "$(new-file)"
            },
            {
                "command": "deltabox.toolchain.generateConfig",
                "title": "Generate config",
                "category": "deltabox",
                "icon": "$(new-file)"
            },
            {
                "command": "deltabox.toolchain.runWorkflow",
                "title": "Run workflow…",
                "category": "deltabox",
                "icon": "$(play)"
            },
            {
                "command": "deltabox.toolchain.resetToolchain",
                "title": "Reset tooling…",
                "category": "deltabox",
                "icon": "$(trash)"
            },
            {
                "command": "deltabox.toolchain.goToProject",
                "title": "Go to project",
                "category": "deltabox",
                "icon": "$(go-to-file)"
            },
            {
                "command": "deltabox.toolchain.refresh",
                "title": "Refresh projects",
                "category": "deltabox",
                "icon": "$(refresh)"
            },
            {
                "command": "deltabox.toolchain.toggle",
                "title": "Toggle auto-sync",
                "category": "deltabox"
            },
            {
                "command": "deltabox.toolchain.refreshFiles",
                "title": "Refresh files",
                "category": "deltabox",
                "icon": "$(refresh)"
            },
            {
                "command": "deltabox.toolchain.runVite",
                "title": "Run Vite+ command…",
                "category": "deltabox",
                "icon": "$(play)",
                "enablement": "deltabox.hasVite"
            },
            {
                "command": "deltabox.toolchain.runProjectVite",
                "title": "Run Vite+ command…",
                "category": "deltabox",
                "icon": "$(play)",
                "enablement": "deltabox.hasVite"
            },
            {
                "command": "deltabox.toolchain.createVite",
                "title": "Create Vite+ project…",
                "category": "deltabox",
                "icon": "$(new-folder)"
            },
            {
                "command": "deltabox.toolchain.templateAdd",
                "title": "Add template…",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.templateRemove",
                "title": "Remove template…",
                "category": "deltabox",
                "icon": "$(remove)"
            },
            {
                "command": "deltabox.toolchain.providers.add",
                "title": "Add provider...",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.providers.refresh",
                "title": "Refresh providers",
                "category": "deltabox",
                "icon": "$(refresh)"
            },
            {
                "command": "deltabox.toolchain.providers.remove",
                "title": "Remove provider",
                "category": "deltabox",
                "icon": "$(trash)"
            },
            {
                "command": "deltabox.toolchain.providers.runCommand",
                "title": "Run command...",
                "category": "deltabox",
                "icon": "$(play)"
            },
            {
                "command": "deltabox.toolchain.providers.openHomepage",
                "title": "Open homepage",
                "category": "deltabox",
                "icon": "$(link-external)"
            },
            {
                "command": "deltabox.toolchain.providers.copyId",
                "title": "Copy provider id",
                "category": "deltabox"
            },
            {
                "command": "deltabox.toolchain.templates.add",
                "title": "Add template...",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.templates.refresh",
                "title": "Refresh templates",
                "category": "deltabox",
                "icon": "$(refresh)"
            },
            {
                "command": "deltabox.toolchain.templates.removeSource",
                "title": "Remove template source...",
                "category": "deltabox",
                "icon": "$(remove)"
            },
            {
                "command": "deltabox.toolchain.templates.create",
                "title": "Create from template...",
                "category": "deltabox",
                "icon": "$(new-folder)"
            },
            {
                "command": "deltabox.toolchain.templates.info",
                "title": "Show template info",
                "category": "deltabox"
            },
            {
                "command": "deltabox.toolchain.templates.copyId",
                "title": "Copy template id",
                "category": "deltabox"
            },
            {
                "command": "deltabox.toolchain.registry.new",
                "title": "New registry…",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.registry.remove",
                "title": "Remove registry…",
                "category": "deltabox",
                "icon": "$(trash)"
            },
            {
                "command": "deltabox.toolchain.registry.refresh",
                "title": "Refresh registries",
                "category": "deltabox",
                "icon": "$(refresh)"
            },
            {
                "command": "deltabox.toolchain.registry.open",
                "title": "Open registry",
                "category": "deltabox",
                "icon": "$(link-external)"
            },
            {
                "command": "deltabox.toolchain.registry.addItem",
                "title": "Add new registry",
                "category": "deltabox",
                "icon": "$(add)"
            },
            {
                "command": "deltabox.toolchain.registry.removeOne",
                "title": "Remove registry",
                "category": "deltabox",
                "icon": "$(trash)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "deltabox",
                    "title": "deltabox toolchain",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "deltabox": [
                {
                    "id": "deltabox.home",
                    "name": "Home",
                    "type": "webview",
                    "contextualTitle": "deltabox toolchain"
                },
                {
                    "id": "deltabox.projects",
                    "name": "Projects",
                    "contextualTitle": "deltabox projects"
                },
                {
                    "id": "deltabox.providers",
                    "name": "Providers",
                    "contextualTitle": "deltabox providers"
                },
                {
                    "id": "deltabox.templates",
                    "name": "Templates",
                    "contextualTitle": "deltabox templates"
                },
                {
                    "id": "deltabox.registries",
                    "name": "Registries",
                    "contextualTitle": "deltabox registries",
                    "visibility": "collapsed"
                },
                {
                    "id": "deltabox.files",
                    "name": "Managed Files",
                    "contextualTitle": "deltabox managed files",
                    "visibility": "collapsed"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "deltabox.toolchain.syncSelected",
                    "when": "view == deltabox.projects",
                    "group": "navigation@1"
                },
                {
                    "command": "deltabox.toolchain.generateConfigs",
                    "when": "view == deltabox.projects",
                    "group": "navigation@2"
                },
                {
                    "command": "deltabox.toolchain.refresh",
                    "when": "view == deltabox.projects",
                    "group": "navigation@3"
                },
                {
                    "command": "deltabox.toolchain.refreshFiles",
                    "when": "view == deltabox.files",
                    "group": "navigation@1"
                },
                {
                    "command": "deltabox.toolchain.providers.add",
                    "when": "view == deltabox.providers",
                    "group": "navigation@1"
                },
                {
                    "command": "deltabox.toolchain.providers.refresh",
                    "when": "view == deltabox.providers",
                    "group": "navigation@2"
                },
                {
                    "command": "deltabox.toolchain.templates.add",
                    "when": "view == deltabox.templates",
                    "group": "navigation@1"
                },
                {
                    "command": "deltabox.toolchain.templates.removeSource",
                    "when": "view == deltabox.templates",
                    "group": "navigation@2"
                },
                {
                    "command": "deltabox.toolchain.templates.refresh",
                    "when": "view == deltabox.templates",
                    "group": "navigation@3"
                },
                {
                    "command": "deltabox.toolchain.registry.new",
                    "when": "view == deltabox.registries",
                    "group": "navigation@1"
                },
                {
                    "command": "deltabox.toolchain.registry.remove",
                    "when": "view == deltabox.registries",
                    "group": "navigation@2"
                },
                {
                    "command": "deltabox.toolchain.registry.refresh",
                    "when": "view == deltabox.registries",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "deltabox.toolchain.syncProject",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "inline@1"
                },
                {
                    "command": "deltabox.toolchain.syncAll",
                    "when": "view == deltabox.projects && viewItem == deltabox.projectGroup",
                    "group": "inline@1"
                },
                {
                    "command": "deltabox.toolchain.checkProject",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "deltabox@1"
                },
                {
                    "command": "deltabox.toolchain.generateConfig",
                    "when": "view == deltabox.projects && viewItem == deltabox.project",
                    "group": "deltabox@2"
                },
                {
                    "command": "deltabox.toolchain.runWorkflow",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "deltabox@3"
                },
                {
                    "command": "deltabox.toolchain.resetToolchain",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "deltabox@4"
                },
                {
                    "command": "deltabox.toolchain.goToProject",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "deltabox@5"
                },
                {
                    "command": "deltabox.toolchain.runProjectVite",
                    "when": "view == deltabox.projects && viewItem =~ /deltabox\\.project/",
                    "group": "deltabox@6"
                },
                {
                    "command": "deltabox.toolchain.providers.runCommand",
                    "when": "view == deltabox.providers && viewItem == deltabox.providerCommand",
                    "group": "inline@1"
                },
                {
                    "command": "deltabox.toolchain.providers.runCommand",
                    "when": "view == deltabox.providers && viewItem =~ /deltabox\\.provider/",
                    "group": "deltabox@1"
                },
                {
                    "command": "deltabox.toolchain.providers.openHomepage",
                    "when": "view == deltabox.providers && viewItem =~ /deltabox\\.provider/",
                    "group": "deltabox@2"
                },
                {
                    "command": "deltabox.toolchain.providers.copyId",
                    "when": "view == deltabox.providers && viewItem =~ /deltabox\\.provider/",
                    "group": "deltabox@3"
                },
                {
                    "command": "deltabox.toolchain.providers.remove",
                    "when": "view == deltabox.providers && viewItem == deltabox.provider.custom",
                    "group": "deltabox@4"
                },
                {
                    "command": "deltabox.toolchain.templates.create",
                    "when": "view == deltabox.templates && viewItem == deltabox.template",
                    "group": "inline@1"
                },
                {
                    "command": "deltabox.toolchain.templates.info",
                    "when": "view == deltabox.templates && viewItem == deltabox.template",
                    "group": "deltabox@1"
                },
                {
                    "command": "deltabox.toolchain.templates.copyId",
                    "when": "view == deltabox.templates && viewItem == deltabox.template",
                    "group": "deltabox@2"
                },
                {
                    "command": "deltabox.toolchain.registry.open",
                    "when": "view == deltabox.registries && viewItem == deltabox.registry",
                    "group": "inline@1"
                },
                {
                    "command": "deltabox.toolchain.registry.addItem",
                    "when": "view == deltabox.registries && viewItem == deltabox.registry",
                    "group": "deltabox@1"
                },
                {
                    "command": "deltabox.toolchain.registry.removeOne",
                    "when": "view == deltabox.registries && viewItem == deltabox.registry",
                    "group": "deltabox@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "deltabox.toolchain.syncProject",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.checkProject",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.generateConfig",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.goToProject",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.runProjectVite",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.providers.remove",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.providers.runCommand",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.providers.openHomepage",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.providers.copyId",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.templates.create",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.templates.info",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.templates.copyId",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.registry.open",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.registry.addItem",
                    "when": "false"
                },
                {
                    "command": "deltabox.toolchain.registry.removeOne",
                    "when": "false"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "deltabox.providers",
                "contents": "No providers available. [Add provider](command:deltabox.toolchain.providers.add)"
            },
            {
                "view": "deltabox.projects",
                "contents": "No projects found. [Refresh projects](command:deltabox.toolchain.refresh) or [Scaffold project](command:deltabox.toolchain.scaffold)."
            },
            {
                "view": "deltabox.templates",
                "contents": "No templates. [Add template](command:deltabox.toolchain.templates.add) or [Refresh](command:deltabox.toolchain.templates.refresh)."
            },
            {
                "view": "deltabox.registries",
                "contents": "No registries. [New registry](command:deltabox.toolchain.registry.new) or [Refresh](command:deltabox.toolchain.registry.refresh)."
            },
            {
                "view": "deltabox.files",
                "contents": "No managed files yet. Run [Sync active project](command:deltabox.toolchain.sync)."
            }
        ],
        "configuration": {
            "title": "deltabox toolchain",
            "properties": {
                "deltabox.toolchain.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Auto sync/generate on watched file changes."
                },
                "deltabox.toolchain.debounce": {
                    "type": "number",
                    "default": 300,
                    "description": "Debounce (ms) before running a sync."
                },
                "deltabox.toolchain.command": {
                    "type": "string",
                    "default": "sync",
                    "description": "The dbx command to run on change."
                },
                "deltabox.toolchain.version": {
                    "type": "string",
                    "default": "",
                    "description": "Pin the @deltabox/toolchain version this workspace runs (empty = auto: the project's install or the extension's bundled CLI)."
                },
                "deltabox.toolchain.watch": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Input globs that trigger a sync. Leave empty (the default) to watch the inputs resolved from each project's dbx.config (the config file plus the tsconfig inputs, honouring custom `tsconfig.rootFile`/`defaultFile` names). Any explicitly set value, even an empty list, replaces them. Generated outputs are never watched (prevents sync loops)."
                },
                "deltabox.registrySearchPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Global template search paths (directories or http(s) registry URLs). Synced with the ~/.dbx/toolchain/cli/config.json registry."
                },
                "deltabox.providerRegistrySearchPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Global provider search paths (JSON files/directories or http(s) registry URLs). Synced with the ~/.dbx/toolchain/cli/config.json registry."
                }
            }
        }
    },
    "scripts": {
        "package:vsix": "tsdown --config ../../tsdown.bin.config.ts --config-loader unrun && tsdown --no-clean --config-loader unrun && npx --yes @vscode/vsce package --no-dependencies --out deltabox-toolchain.vsix"
    },
    "devDependencies": {
        "@deltabox/toolchain-tsdown": "workspace:*",
        "@types/node": "catalog:",
        "@types/vscode": "^1.85.0",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "author": "Victor Sango <victor@deltabox.studio>",
    "license": "MPL-2.0",
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1"
}
