{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run deltabox toolchain extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/test-fixtures/workspace"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
            "preLaunchTask": "build extension"
        }
    ]
}
