{
    "name": "vite-plugin-dbx",
    "version": "2.6.1",
    "description": "Plugin for Vite/Vite+ with rich extras: project synchronization, a config generator, tsconfig management, MCP server, CI/changelog automation, providers, catalogs and managed files.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/vite"
    },
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "vite",
        "vite-plus",
        "vite-plugin",
        "plugin",
        "dbx",
        "deltabox",
        "toolchain",
        "config",
        "sync",
        "formatter",
        "linter"
    ],
    "dependencies": {
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*"
    },
    "devDependencies": {
        "@deltabox/toolchain-tsdown": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "vite-plus": ">=1"
    },
    "peerDependenciesMeta": {
        "vite-plus": {
            "optional": true
        }
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1"
}
