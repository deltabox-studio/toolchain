{
    "name": "@deltabox/toolchain-vite",
    "version": "1.7.4",
    "description": "Vite+ provider: wraps the `vp` binary as `dbx vite:*` commands, exposes the Vite+ toolchain and manages its vite.config.ts.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/vite"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "private": true,
    "dependencies": {
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*"
    },
    "devDependencies": {
        "@deltabox/toolchain-tsdown": "workspace:*",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "vite": ">=5"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./package.json": "./package.json"
    }
}
