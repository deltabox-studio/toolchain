{
    "name": "@deltabox/toolchain-core",
    "version": "1.2.5",
    "description": "Loads dbx.config.*, runs the sync tasks and watches key files.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/core"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "private": true,
    "dependencies": {
        "@deltabox/toolchain-shared": "workspace:*",
        "glob": "catalog:",
        "tsx": "catalog:"
    },
    "devDependencies": {
        "@deltabox/toolchain-tsdown": "workspace:*",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    }
