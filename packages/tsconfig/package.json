{
    "name": "@deltabox/toolchain-tsconfig",
    "version": "2.6.1",
    "description": "TypeScript config templates plus the tsconfig generator with path-alias, project-reference and include/exclude wiring.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/tsconfig"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*",
        "glob": "catalog:",
        "type-fest": "catalog:"
    },
    "devDependencies": {
        "@deltabox/toolchain-tsdown": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./cli/generate": "./dist/cli/generate/index.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "toolchain-tsconfig": "./dist/cli/generate/index.js"
    },
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1",
    "keywords": [
        "tsconfig",
        "typescript",
        "paths",
        "project-references",
        "config",
        "dbx",
        "deltabox",
        "toolchain"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
