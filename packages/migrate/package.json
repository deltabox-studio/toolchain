{
    "name": "@deltabox/toolchain-migrate",
    "version": "3.0.0-beta.1",
    "description": "Pluggable migrations of Biome, ESLint, Prettier and dprint tooling to Oxfmt and Oxlint, mapping formatter/linter rules into dbx config.",
    "author": "Victor Sango <victor@deltabox.studio>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deltabox-studio/toolchain.git",
        "directory": "packages/migrate"
    },
    "license": "MPL-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@clack/prompts": "catalog:",
        "@deltabox/toolchain-core": "workspace:*",
        "@deltabox/toolchain-shared": "workspace:*",
        "glob": "catalog:"
    },
    "devDependencies": {
        "@deltabox/toolchain-pack": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    },
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/index.js",
        "./package.json": "./package.json"
    },
    "homepage": "https://toolchain.deltabox.studio",
    "packageManager": "yarn@4.17.1",
    "keywords": [
        "migration",
        "biome",
        "eslint",
        "prettier",
        "dprint",
        "oxfmt",
        "oxlint",
        "dbx",
        "deltabox",
        "toolchain"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
