{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 100,
    "endOfLine": "lf",
    "insertFinalNewline": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "es5",
    "semi": true,
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleAttributePerLine": false,
    "objectWrap": "preserve",
    "proseWrap": "preserve",
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "vueIndentScriptAndStyle": false,
    "sortPackageJson": false,
    "sortImports": {
        "groups": [
            "builtin",
            "external",
            "workspace",
            [
                "internal",
                "subpath"
            ],
            [
                "parent",
                "sibling",
                "index"
            ],
            "style",
            "unknown"
        ],
        "customGroups": [
            {
                "groupName": "workspace",
                "elementNamePattern": [
                    "@deltabox/**",
                    "toolchain",
                    "toolchain/**",
                    "toolchain-biome",
                    "toolchain-biome/**",
                    "toolchain-changelog",
                    "toolchain-changelog/**",
                    "toolchain-config",
                    "toolchain-config/**",
                    "toolchain-core",
                    "toolchain-core/**",
                    "toolchain-migrate",
                    "toolchain-migrate/**",
                    "toolchain-project",
                    "toolchain-project/**",
                    "toolchain-shared",
                    "toolchain-shared/**",
                    "toolchain-template",
                    "toolchain-template/**",
                    "toolchain-tsconfig",
                    "toolchain-tsconfig/**",
                    "toolchain-tsdown",
                    "toolchain-tsdown/**",
                    "toolchain-vite",
                    "toolchain-vite/**",
                    "toolchain-vscode",
                    "toolchain-vscode/**"
                ]
            }
        ],
        "internalPattern": [
            "~/",
            "@/"
        ],
        "newlinesBetween": true
    },
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.turbo/**",
        "**/.generated/**",
        "*.json",
        "packages/*/*.json",
        "**/tsconfig*.json",
        "biome.json",
        "**/*.yml",
        "**/*.yaml",
        "**/CHANGELOG.md",
        "CHANGELOG.proposed.md",
        "**/vite.config.ts",
        "**/config-schema/generated/biome-config.ts",
        "**/config-schema/generated/azure-pipelines.ts",
        "**/config-schema/generated/oxlint-config.ts"
    ]
}
