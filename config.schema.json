{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DbxConfigSections",
    "$defs": {
        "DbxConfigSections": {
            "type": "object",
            "properties": {
                "toolchain": {
                    "$ref": "#/$defs/ToolchainConfigSections"
                }
            },
            "additionalProperties": false
        },
        "ToolchainConfigSections": {
            "type": "object",
            "properties": {
                "project": {
                    "$ref": "#/$defs/ToolchainProjectConfig"
                },
                "changelog": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainChangelogConfig"
                        }
                    ]
                },
                "biome": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainBiomeConfig"
                        }
                    ]
                },
                "tsconfig": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainTsconfigConfig"
                        }
                    ]
                },
                "templates": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainTemplatesConfig"
                        }
                    ]
                },
                "vite": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainViteConfig"
                        }
                    ]
                },
                "watch": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainWatchConfig"
                        }
                    ]
                },
                "logger": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainLoggerConfig"
                        }
                    ]
                },
                "providers": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainProvidersConfig"
                        }
                    ]
                }
            },
            "additionalProperties": false
        },
        "ToolchainProjectConfig": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/ProjectType"
                },
                "name": {
                    "type": "string",
                    "description": "The unscoped project name."
                },
                "scope": {
                    "type": "string",
                    "description": "The npm scope, eg. `@acme`."
                },
                "author": {
                    "type": "string",
                    "description": "Package author."
                },
                "license": {
                    "type": "string",
                    "description": "SPDX license id."
                },
                "homepage": {
                    "type": "string",
                    "description": "Project homepage."
                },
                "repo": {
                    "type": "string",
                    "description": "Repository URL, eg. `https://github.com/acme/app`."
                },
                "nodeVersion": {
                    "type": "string",
                    "description": "Node engine range, eg. `>=22`."
                },
                "packageManager": {
                    "type": "string",
                    "description": "Package manager name (default `yarn`)."
                },
                "packageManagerVersion": {
                    "type": "string",
                    "description": "Package manager version, eg. `4.17.1`."
                },
                "description": {
                    "type": "string",
                    "description": "One-line description."
                }
            },
            "additionalProperties": false
        },
        "ProjectType": {
            "type": "string",
            "enum": [
                "monorepo-root",
                "monorepo-workspace",
                "project"
            ],
            "description": "The project kind (detected when omitted)."
        },
        "ToolchainChangelogConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "workflows": {
                    "description": "Which workflows to write into `.github/workflows`.",
                    "$ref": "#/$defs/ChangelogWorkflowsConfig"
                },
                "branches": {
                    "type": "object",
                    "properties": {
                        "main": {
                            "type": "string"
                        },
                        "dev": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Branch names the workflows target."
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Allowed commit types (commitlint)."
                },
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Allowed commit scopes (commitlint)."
                },
                "vscode": {
                    "type": "boolean",
                    "description": "Write the Conventional-Commits VS Code settings."
                }
            },
            "additionalProperties": false
        },
        "WorkflowSetting": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "$ref": "#/$defs/WorkflowConfig"
                }
            ]
        },
        "WorkflowConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable/disable this workflow (default true)."
                },
                "pushBranches": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Replace `on.push.branches`."
                },
                "pullRequestBranches": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Replace `on.pull_request.branches`."
                },
                "triggers": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra `on.*` triggers."
                },
                "extra": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra top-level keys (`permissions`, `concurrency`, `env`, ...)."
                },
                "steps": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WorkflowStepsConfig"
                        },
                        {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/WorkflowStepsConfig"
                            }
                        }
                    ],
                    "description": "Extra steps for a job (one group, or per-job groups)."
                },
                "jobs": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra complete jobs merged in."
                },
                "tokens": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    },
                    "description": "Per-workflow token overrides (`nodeVersion`, `packageManager`, ...)."
                }
            },
            "additionalProperties": false
        },
        "WorkflowStepsConfig": {
            "type": "object",
            "properties": {
                "job": {
                    "type": "string",
                    "description": "Target job id (defaults to the primary/first job)."
                },
                "before": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/WorkflowStep"
                    },
                    "description": "Steps inserted at the start."
                },
                "after": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/WorkflowStep"
                    },
                    "description": "Steps appended at the end."
                }
            },
            "additionalProperties": false
        },
        "WorkflowStep": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "if": {
                    "type": "string"
                },
                "uses": {
                    "type": "string"
                },
                "run": {
                    "type": "string"
                },
                "shell": {
                    "type": "string"
                },
                "working-directory": {
                    "type": "string"
                },
                "with": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    }
                },
                "env": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "ChangelogWorkflowsConfig": {
            "type": "object",
            "properties": {
                "ci": {
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "changelog": {
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "release": {
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "issues": {
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "sync": {
                    "$ref": "#/$defs/WorkflowSetting"
                }
            },
            "additionalProperties": false
        },
        "ToolchainBiomeConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "vscode": {
                    "type": "boolean",
                    "description": "Write the Biome VS Code settings (default true)."
                },
                "overrides": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Deep-merged over the generated `biome.json` (arrays union)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTsconfigConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "glob": {
                    "type": "string",
                    "description": "Glob for workspace `tsconfig.default.json` files."
                },
                "appGlob": {
                    "type": "string",
                    "description": "Glob for \"override\" (app) workspaces."
                },
                "refs": {
                    "type": "boolean",
                    "description": "Wire project references (default false)."
                },
                "composite": {
                    "type": "boolean",
                    "description": "Emit `composite: true` (default false)."
                },
                "aliases": {
                    "type": "boolean",
                    "description": "Inject path aliases (default true)."
                },
                "indent": {
                    "type": "number",
                    "description": "JSON indentation (default 4)."
                },
                "rootFile": {
                    "type": "string",
                    "description": "The monorepo tsconfig file name (default `tsconfig.monorepo.json`)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTemplatesConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ToolchainTemplateSource"
                    },
                    "description": "Extra sources on top of the builtin + registry sources."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTemplateSource": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/ToolchainTemplateSourceType"
                },
                "locate": {
                    "type": "string",
                    "description": "A builtin id, local dir, npm scope, git URL or Vite+ id."
                },
                "id": {
                    "type": "string",
                    "description": "Stable id (defaults to the basename/scope)."
                },
                "name": {
                    "type": "string",
                    "description": "Display name override."
                },
                "description": {
                    "type": "string",
                    "description": "Description override."
                },
                "kind": {
                    "$ref": "#/$defs/ToolchainTemplateKind"
                },
                "ref": {
                    "type": "string",
                    "description": "Git branch/tag/commit."
                },
                "subdir": {
                    "type": "string",
                    "description": "Subdirectory within the source that holds the template."
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Free-form tags."
                },
                "online": {
                    "type": "boolean",
                    "description": "Whether the source needs network access."
                }
            },
            "required": [
                "type",
                "locate"
            ],
            "additionalProperties": false
        },
        "ToolchainTemplateSourceType": {
            "type": "string",
            "enum": [
                "builtin",
                "local",
                "npm",
                "git",
                "vite-plus"
            ],
            "description": "How to load the source."
        },
        "ToolchainTemplateKind": {
            "type": "string",
            "enum": [
                "project",
                "workspace",
                "application",
                "folder",
                "tooling",
                "pipeline"
            ],
            "description": "What the template produces."
        },
        "ToolchainViteConfig": {
            "type": "object",
            "properties": {
                "config": {
                    "type": "boolean",
                    "description": "Write the managed `vite.config.ts` (default true)."
                }
            },
            "additionalProperties": {}
        },
        "ToolchainWatchConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Watch by default (enabled when the section is defined)."
                },
                "debounce": {
                    "type": "number",
                    "description": "Debounce window in ms (default 150)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainLoggerConfig": {
            "type": "object",
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "debug",
                        "info",
                        "warn",
                        "error",
                        "silent"
                    ],
                    "description": "Minimum level to print (default `info`)."
                },
                "color": {
                    "type": "boolean",
                    "description": "Force colours on/off (default: auto)."
                },
                "name": {
                    "type": "string",
                    "description": "Prefix non-indented lines with `<name>:` (default `dbx`)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainProvidersConfig": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "boolean",
                    "description": "Force provider command colours on/off (default: inherit the logger)."
                }
            },
            "additionalProperties": false
        }
    },
    "$id": "https://deltabox.studio/schemas/dbx.config.json",
    "title": "dbx.config",
    "description": "The dbx configuration model (the @deltabox/toolchain settings live under `toolchain`)."
}
