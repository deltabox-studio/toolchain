{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DbxConfigSections",
    "$defs": {
        "DbxConfigSections": {
            "type": "object",
            "properties": {
                "toolchain": {
                    "description": "The `@deltabox/toolchain` settings (every section is opt-in by presence).",
                    "$ref": "#/$defs/ToolchainConfigSections"
                }
            },
            "additionalProperties": false
        },
        "ProjectType": {
            "type": "string",
            "enum": [
                "monorepo-root",
                "monorepo-workspace",
                "project"
            ],
            "description": "The project kind (detected when omitted)."
        },
        "ToolchainProjectConfig": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/ProjectType"
                },
                "name": {
                    "type": "string",
                    "description": "The unscoped project name (written as `<scope>/<name>`)."
                },
                "scope": {
                    "type": "string",
                    "description": "The npm scope, eg. `@acme`."
                },
                "author": {
                    "type": "string",
                    "description": "Package author (`package.json` `author`)."
                },
                "license": {
                    "type": "string",
                    "description": "SPDX license id (`package.json` `license`)."
                },
                "homepage": {
                    "type": "string",
                    "description": "Project homepage (`package.json` `homepage`)."
                },
                "repo": {
                    "type": "string",
                    "description": "Repository URL (`package.json` `repository`). For a workspace it also resolves to the workspace path (`repository.directory`)."
                },
                "nodeVersion": {
                    "type": "string",
                    "description": "Node version for CI/templates, eg. `22` (not `package.json` `engines`)."
                },
                "packageManager": {
                    "type": "string",
                    "description": "Package manager name, written as `<name>@<version>` (default `yarn`)."
                },
                "packageManagerVersion": {
                    "type": "string",
                    "description": "Package manager version, eg. `4.17.1`."
                },
                "description": {
                    "type": "string",
                    "description": "One-line description (`package.json` `description`)."
                },
                "inherit": {
                    "type": "boolean",
                    "description": "Inherit the parent project metadata (default true). Set false to keep this project entirely independent of the root config."
                }
            },
            "additionalProperties": false
        },
        "ToolchainChangelogConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "workflows": {
                    "description": "Which workflows to write into `.github/workflows`. Each id is `true`/`false`, an object of overrides, or a raw YAML string written verbatim.",
                    "$ref": "#/$defs/ChangelogWorkflowsConfig"
                },
                "branches": {
                    "type": "object",
                    "properties": {
                        "main": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "description": "Branch glob(s) the CI + release workflows run on, and the release PR base (default `[\"main\"]`)."
                        },
                        "dev": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "description": "Branch glob(s) the changelog/version workflow runs on. No default: when omitted it reuses `main` (so a single-branch repo needs no `dev`)."
                        }
                    },
                    "additionalProperties": false,
                    "description": "Branches the generated workflows target."
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Allowed commit types (commitlint)."
                },
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Allowed commit scopes (commitlint)."
                },
                "commitlint": {
                    "type": "object",
                    "properties": {
                        "dir": {
                            "type": "string",
                            "description": "Directory the generated `commitlint.config.mjs` is written to (default: the project root). The husky hook and CI use `--config` to point at it."
                        }
                    },
                    "additionalProperties": false,
                    "description": "commitlint config output location."
                },
                "versioning": {
                    "description": "Automatic version bumping on changelog generation (default `true`).",
                    "$ref": "#/$defs/ChangelogVersioning"
                },
                "vscode": {
                    "type": "boolean",
                    "description": "Write the Conventional-Commits VS Code settings."
                }
            },
            "additionalProperties": false
        },
        "WorkflowConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable/disable this workflow (default true)."
                },
                "pushBranches": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Replace `on.push.branches`."
                },
                "pullRequestBranches": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Replace `on.pull_request.branches`."
                },
                "triggers": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra `on.*` triggers."
                },
                "extra": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra top-level keys (`permissions`, `concurrency`, `env`, ...)."
                },
                "steps": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/WorkflowStepsConfig"
                        },
                        {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/WorkflowStepsConfig"
                            }
                        }
                    ],
                    "description": "Extra steps for a job (one group, or per-job groups)."
                },
                "jobs": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Extra complete jobs merged in."
                },
                "tokens": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    },
                    "description": "Per-workflow token overrides (`nodeVersion`, `packageManager`, ...)."
                }
            },
            "additionalProperties": false
        },
        "WorkflowStepsConfig": {
            "type": "object",
            "properties": {
                "job": {
                    "type": "string",
                    "description": "Target job id (defaults to the primary/first job)."
                },
                "before": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/WorkflowStep"
                    },
                    "description": "Steps inserted at the start."
                },
                "after": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/WorkflowStep"
                    },
                    "description": "Steps appended at the end."
                }
            },
            "additionalProperties": false
        },
        "WorkflowStep": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Step display name."
                },
                "id": {
                    "type": "string",
                    "description": "Step id (for `steps.<id>` outputs)."
                },
                "if": {
                    "type": "string",
                    "description": "Conditional expression (`if:`)."
                },
                "uses": {
                    "type": "string",
                    "description": "Action to run (`uses:`), eg. `actions/checkout@v4`."
                },
                "run": {
                    "type": "string",
                    "description": "Shell command(s) to run (`run:`)."
                },
                "shell": {
                    "type": "string",
                    "description": "Shell to run `run` in, eg. `bash`."
                },
                "working-directory": {
                    "type": "string",
                    "description": "Directory the step runs in."
                },
                "with": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    },
                    "description": "Inputs for a `uses` action."
                },
                "env": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Environment variables for the step."
                }
            },
            "additionalProperties": false
        },
        "WorkflowSetting": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "string"
                },
                {
                    "$ref": "#/$defs/WorkflowConfig"
                }
            ],
            "description": "`true`/`false` to enable/disable, an object to override parts of the default, or a raw YAML string written verbatim as the workflow file."
        },
        "ChangelogWorkflowsConfig": {
            "type": "object",
            "properties": {
                "ci": {
                    "description": "The CI workflow (`ci.yml`).",
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "changelog": {
                    "description": "The changelog/version workflow (`changelog.yml`).",
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "release": {
                    "description": "The release workflow (`release.yml`).",
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "issues": {
                    "description": "The issue-title workflow (`issues.yml`).",
                    "$ref": "#/$defs/WorkflowSetting"
                },
                "sync": {
                    "description": "The toolchain sync workflow (`sync.yml`).",
                    "$ref": "#/$defs/WorkflowSetting"
                }
            },
            "additionalProperties": false
        },
        "ChangelogVersioningConfig": {
            "type": "object",
            "properties": {
                "target": {
                    "description": "`uniform` bumps the root and every workspace to one shared version; `root-only` bumps the root only; `individual` bumps each changed workspace independently (default `uniform`).",
                    "$ref": "#/$defs/ChangelogVersioningTarget"
                },
                "workspaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Glob patterns selecting the workspaces to version (relative to the root). Defaults to the root `package.json` `workspaces` field; when there is none the root `package.json` is used on its own."
                }
            },
            "additionalProperties": false
        },
        "ChangelogVersioningTarget": {
            "type": "string",
            "enum": [
                "uniform",
                "root-only",
                "individual"
            ],
            "description": "Where the changelog version bump is applied."
        },
        "ChangelogVersioning": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "$ref": "#/$defs/ChangelogVersioningConfig"
                }
            ],
            "description": "Automatic version bumping when a changelog entry is generated."
        },
        "ToolchainBiomeConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "vscode": {
                    "type": "boolean",
                    "description": "Write the Biome VS Code settings (default true)."
                },
                "overrides": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Deep-merged over the generated `biome.json` (arrays union)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTsconfigConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "glob": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ],
                    "description": "Glob(s) for the workspace default tsconfig files. Defaults to matching every `defaultFile` recursively."
                },
                "exclude": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ],
                    "description": "Glob(s) to exclude from `glob`. Defaults to the common ignored paths (`node_modules`, `.dbx`, `dist`, `build`, ...)."
                },
                "gitignore": {
                    "type": "boolean",
                    "description": "Also respect `.gitignore` files (root + nested) when matching `glob` (default true)."
                },
                "refs": {
                    "type": "boolean",
                    "description": "Wire project references (default false)."
                },
                "composite": {
                    "type": "boolean",
                    "description": "Emit `composite: true` (default false)."
                },
                "aliases": {
                    "type": "boolean",
                    "description": "Inject path aliases (default true)."
                },
                "indent": {
                    "type": "number",
                    "description": "JSON indentation (default 4)."
                },
                "rootFile": {
                    "type": "string",
                    "description": "The workspaces tsconfig file name that holds `paths` + `references` (default `tsconfig.workspaces.json`)."
                },
                "defaultFile": {
                    "type": "string",
                    "description": "The workspace default tsconfig file name that the generator expands (default `tsconfig.default.json`)."
                },
                "buildFile": {
                    "type": "string",
                    "description": "The workspace build tsconfig file name (default `tsconfig.build.json`)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTemplatesConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Master switch (enabled when the section is defined)."
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ToolchainTemplateSource"
                    },
                    "description": "Extra sources on top of the builtin + registry sources."
                }
            },
            "additionalProperties": false
        },
        "ToolchainTemplateSource": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/ToolchainTemplateSourceType"
                },
                "locate": {
                    "type": "string",
                    "description": "A builtin id, local dir, npm scope, git URL or Vite+ id."
                },
                "id": {
                    "type": "string",
                    "description": "Stable id (defaults to the basename/scope)."
                },
                "name": {
                    "type": "string",
                    "description": "Display name override."
                },
                "description": {
                    "type": "string",
                    "description": "Description override."
                },
                "kind": {
                    "$ref": "#/$defs/ToolchainTemplateKind"
                },
                "ref": {
                    "type": "string",
                    "description": "Git branch/tag/commit."
                },
                "subdir": {
                    "type": "string",
                    "description": "Subdirectory within the source that holds the template."
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Free-form tags."
                },
                "online": {
                    "type": "boolean",
                    "description": "Whether the source needs network access."
                }
            },
            "required": [
                "type",
                "locate"
            ],
            "additionalProperties": false
        },
        "ToolchainTemplateSourceType": {
            "type": "string",
            "enum": [
                "builtin",
                "local",
                "npm",
                "git",
                "vite-plus"
            ],
            "description": "How to load the source."
        },
        "ToolchainTemplateKind": {
            "type": "string",
            "enum": [
                "project",
                "workspace",
                "application",
                "folder",
                "tooling",
                "pipeline"
            ],
            "description": "What the template produces."
        },
        "ToolchainViteConfig": {
            "type": "object",
            "properties": {
                "config": {
                    "type": "boolean",
                    "description": "Write the managed `vite.config.ts` (default true)."
                }
            },
            "additionalProperties": {}
        },
        "ToolchainWatchConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Watch by default (enabled when the section is defined)."
                },
                "debounce": {
                    "type": "number",
                    "description": "Debounce window in ms (default 150)."
                },
                "exclude": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ],
                    "description": "Glob(s) excluded from watching. Defaults to the common ignored paths (`node_modules`, `.dbx`, `dist`, `build`, ...)."
                },
                "gitignore": {
                    "type": "boolean",
                    "description": "Also respect `.gitignore` files (root + nested) when watching (default true)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainLoggerConfig": {
            "type": "object",
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "debug",
                        "info",
                        "warn",
                        "error",
                        "silent"
                    ],
                    "description": "Minimum level to print (default `info`)."
                },
                "color": {
                    "type": "boolean",
                    "description": "Force colours on/off (default: on; `--no-color` disables)."
                },
                "name": {
                    "type": "string",
                    "description": "Prefix non-indented lines with `<name>:` (default `dbx`)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainProvidersConfig": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "boolean",
                    "description": "Force provider command colours on/off (default: inherit the logger)."
                }
            },
            "additionalProperties": false
        },
        "ToolchainConfigSections": {
            "type": "object",
            "properties": {
                "project": {
                    "description": "Project metadata: canonical `package.json` fields and template tokens (inherited by workspaces).",
                    "$ref": "#/$defs/ToolchainProjectConfig"
                },
                "changelog": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainChangelogConfig"
                        }
                    ],
                    "description": "Conventional-Commits CI, commitlint and the changelog pipeline."
                },
                "biome": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainBiomeConfig"
                        }
                    ],
                    "description": "Biome config generation (for consumers that still want a `biome.json`)."
                },
                "tsconfig": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainTsconfigConfig"
                        }
                    ],
                    "description": "Workspace tsconfig generation (path aliases + project references)."
                },
                "templates": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainTemplatesConfig"
                        }
                    ],
                    "description": "Template sources / scaffolding."
                },
                "vite": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainViteConfig"
                        }
                    ],
                    "description": "The full Vite+ config; `dbx sync` writes the root `vite.config.ts` from it."
                },
                "watch": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainWatchConfig"
                        }
                    ],
                    "description": "Watch behaviour for `dbx watch`."
                },
                "logger": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainLoggerConfig"
                        }
                    ],
                    "description": "Logging level, colours and prefix for toolchain output."
                },
                "providers": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "$ref": "#/$defs/ToolchainProvidersConfig"
                        }
                    ],
                    "description": "Provider command behaviour (eg. colour for the passthrough commands)."
                }
            },
            "additionalProperties": false
        }
    },
    "$id": "https://deltabox.studio/schemas/dbx.config.json",
    "title": "dbx.config",
    "description": "The dbx configuration model (the @deltabox/toolchain settings live under `toolchain`)."
}
